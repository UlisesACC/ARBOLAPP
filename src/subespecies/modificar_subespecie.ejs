<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Modificar Subespecie</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
</head>

<body class="bg-green-50 min-h-screen flex flex-col">

  <!-- NAVBAR -->
  <nav class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div class="text-xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600 transition">Inicio</a></li>
        <li><a href="/formulario" class="hover:text-green-600 transition">Registrar Árbol</a></li>
        <li><a href="/lista_especies" class="hover:text-green-600 transition">Lista de Especies</a></li>
        <li><a href="/nueva_subespecie" class="hover:text-green-600 transition">Registrar Subespecie</a></li>
        <li><a href="/lista_subespecies" class="hover:text-green-600 transition">Lista de Subespecies</a></li>
      </ul>
    </div>
  </nav>

  <!-- FORMULARIO -->
  <main class="flex-1 container mx-auto px-4 pt-32 flex justify-center">
    <div class="bg-white shadow-2xl rounded-2xl p-10 w-full max-w-2xl">
      <h1 class="text-3xl font-bold text-center text-green-700 mb-6">Modificar Subespecie</h1>

      <form action="/modificar_subespecie/<%= subespecie.id_subespecie %>" method="POST" class="space-y-6" id="formulario-modificar">

        <!-- Especie principal -->
        <div>
          <label for="id_especie" class="block text-gray-700 font-semibold mb-2">Especie Principal:</label>
          <select name="id_especie" id="id_especie" required
            class="w-full p-2 h-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
            <% especies.forEach(especie => { %>
              <option value="<%= especie.id_especie %>" 
                <% if (especie.id_especie === subespecie.id_especie) { %> selected <% } %>>
                <%= especie.nombre %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Nombre de la subespecie -->
        <div>
          <label for="nombre_subespecie" class="block text-gray-700 font-semibold mb-2">Nombre de Subespecie:</label>
          <input type="text" name="nombre_subespecie" id="nombre_subespecie" value="<%= subespecie.nombre_subespecie %>" required
            class="w-full p-2 h-10 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>

        <!-- Botón de guardar -->
        <button id="btn-guardar" type="submit"
          class="w-full bg-green-700 hover:bg-green-800 text-white font-bold py-3 rounded-xl transition transform">
          Guardar Cambios
        </button>

      </form>
    </div>
  </main>

  <!-- SCRIPT -->
  <script>
    // Animar el botón cuando se envía el formulario
    const formulario = document.getElementById('formulario-modificar');
    const boton = document.getElementById('btn-guardar');

    formulario.addEventListener('submit', (e) => {
      anime({
        targets: '#btn-guardar',
        scale: [1, 0.9, 1],
        duration: 600,
        easing: 'easeInOutQuad'
      });
    });
  </script>

</body>

</html>
