<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Mantenimiento de Árboles</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-green-800 mb-6 text-center">🌳 Registro de Mantenimiento de Árboles 🌳</h1>
        
        <form class="bg-white shadow-md rounded-lg p-6 max-w-3xl mx-auto" action="/mantenimiento" method="POST" enctype="multipart/form-data">
            <fieldset class="space-y-6">
                <legend class="text-xl font-semibold text-green-700 border-b border-green-200 pb-2 mb-4">📝 Detalles de la Intervención</legend>
                
                <!-- Fecha de Intervención -->
                <div class="form-group">
                    <label for="fecha" class="block text-sm font-medium text-gray-700">Fecha de Intervención</label>
                    <input type="date" id="fecha" name="fecha" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                </div>
                
                <!-- Tipo de Intervención -->
                <div class="form-group">
                    <label for="tipo_intervencion" class="block text-sm font-medium text-gray-700">Tipo de Intervención</label>
                    <select id="tipo_intervencion" name="tipo_intervencion" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                        <option value="">Seleccione un tipo...</option>
                        <option value="poda">Poda</option>
                        <option value="derribo">Derribo</option>
                        <option value="trasplante">Trasplante</option>
                        <option value="restitucion">Restitución</option>
                    </select>
                </div>
                
                <!-- Contenedor dinámico para sub-opciones -->
                <div id="subopciones-container" class="space-y-4">
                    <!-- Poda -->
                    <div id="poda-options" class="hidden sub-options space-y-4">
                        <div>
                            <label for="tipo_poda" class="block text-sm font-medium text-gray-700">Tipo de Poda</label>
                            <select id="tipo_poda" name="tipo_poda" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="formacion">Formación</option>
                                <option value="limpieza">Limpieza de Copa</option>
                                <option value="restauracion">Restauración de Copa</option>
                                <option value="aclareo">Aclareo de Copa</option>
                                <option value="elevacion">Elevación de Copa</option>
                                <option value="reduccion">Reducción de Copa</option>
                                <option value="cableado">Poda bajo cableado eléctrico aéreo</option>
                                <option value="raices">Poda de Raíces</option>
                            </select>
                        </div>
                        <div>
                            <label for="causa_poda" class="block text-sm font-medium text-gray-700">Causa de la Poda</label>
                            <select id="causa_poda" name="causa_poda" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="riesgo">Riesgo</option>
                                <option value="fitosanitario">Estado Fitosanitario</option>
                                <option value="estructura">Restauración de la Estructura</option>
                                <option value="infraestructura">Afectación Severa de la Infraestructura</option>
                                <option value="mantenimiento">Mantenimiento</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Derribo -->
                    <div id="derribo-options" class="hidden sub-options space-y-4">
                        <div>
                            <label for="causa_derribo" class="block text-sm font-medium text-gray-700">Causa del Derribo</label>
                            <select id="causa_derribo" name="causa_derribo" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="riesgo">Riesgo</option>
                                <option value="mejoramiento">Mejoramiento y Mantenimiento de Área Verde</option>
                                <option value="afectacion">Afectación Severa al Patrimonio/Mobiliario/Inmuebles</option>
                                <option value="obra">Obra Pública y Privada</option>
                            </select>
                        </div>
                        <div>
                            <label for="tipo_derribo" class="block text-sm font-medium text-gray-700">Tipo de Derribo</label>
                            <select id="tipo_derribo" name="tipo_derribo" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="controlado">Controlado</option>
                                <option value="direccional">Direccional</option>
                            </select>
                        </div>
                        <div>
                            <label for="destino_material" class="block text-sm font-medium text-gray-700">Destino del Material</label>
                            <input type="text" id="destino_material" name="destino_material" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                        </div>
                    </div>
                    
                    <!-- Trasplante -->
                    <div id="trasplante-options" class="hidden sub-options space-y-4">
                        <div>
                            <label for="ubicacion_original" class="block text-sm font-medium text-gray-700">Ubicación Original (ID del árbol o descripción)</label>
                            <input type="text" id="ubicacion_original" name="ubicacion_original" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                        </div>
                        <div>
                            <label for="nueva_ubicacion" class="block text-sm font-medium text-gray-700">Nueva Ubicación</label>
                            <textarea id="nueva_ubicacion" name="nueva_ubicacion" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500"></textarea>
                        </div>
                        <div>
                            <label for="exito_trasplante" class="block text-sm font-medium text-gray-700">Éxito del Trasplante</label>
                            <select id="exito_trasplante" name="exito_trasplante" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="exitoso">Exitoso</option>
                                <option value="seguimiento">En Seguimiento</option>
                                <option value="fallido">Fallido</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Restitución -->
                    <div id="restitucion-options" class="hidden sub-options space-y-4">
                        <div>
                            <label for="tipo_restitucion" class="block text-sm font-medium text-gray-700">Tipo de Restitución</label>
                            <select id="tipo_restitucion" name="tipo_restitucion" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                                <option value="">Seleccione...</option>
                                <option value="fisica">Física</option>
                                <option value="economica">Económica</option>
                            </select>
                        </div>
                        <div>
                            <label for="detalles_restitucion" class="block text-sm font-medium text-gray-700">Detalles de la Restitución</label>
                            <textarea id="detalles_restitucion" name="detalles_restitucion" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500"></textarea>
                        </div>
                    </div>
                </div>
                
                <!-- Descripción y Responsable -->
                <div class="form-group">
                    <label for="descripcion" class="block text-sm font-medium text-gray-700">Descripción de la Intervención</label>
                    <textarea id="descripcion" name="descripcion" rows="4" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="responsable" class="block text-sm font-medium text-gray-700">Responsable de la Intervención</label>
                    <input type="text" id="responsable" name="responsable" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500">
                </div>
                
                <!-- Observaciones -->
                <div class="form-group">
                    <label for="observaciones" class="block text-sm font-medium text-gray-700">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500"></textarea>
                </div>
                
                <!-- Fotografías -->
                <div class="form-group">
                    <label class="block text-sm font-medium text-gray-700">Fotografías de la Intervención</label>
                    <div class="mt-1 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label for="foto_antes" class="block text-xs text-gray-500 mb-1">Foto Antes</label>
                            <input type="file" id="foto_antes" name="foto_antes" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
                        </div>
                        <div>
                            <label for="foto_despues" class="block text-xs text-gray-500 mb-1">Foto Después</label>
                            <input type="file" id="foto_despues" name="foto_despues" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
                        </div>
                    </div>
                </div>
                
                <!-- Botón de envío -->
                <div class="pt-4">
                    <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150 ease-in-out">
                        Registrar Intervención
                    </button>
                </div>
            </fieldset>
        </form>
    </div>

    <script>
        // Mostrar/ocultar sub-opciones según el tipo de intervención seleccionado
        document.getElementById('tipo_intervencion').addEventListener('change', function() {
            // Ocultar todas las sub-opciones primero
            document.querySelectorAll('.sub-options').forEach(el => {
                el.classList.add('hidden');
            });
            
            // Mostrar solo las sub-opciones relevantes
            const selectedOption = this.value;
            if (selectedOption) {
                document.getElementById(`${selectedOption}-options`).classList.remove('hidden');
            }
        });
    </script>
</body>
</html>