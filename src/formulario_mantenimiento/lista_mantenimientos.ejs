<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
  <title>Lista de Mantenimientos</title>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Barra de navegación -->
  <nav class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div class="text-2xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600">Inicio</a></li>
        <li><a href="/mantenimiento/formulario" class="hover:text-green-600">Formulario Mantenimiento</a></li>
        <li><a href="/mantenimiento/lista" class="hover:text-green-600">Lista Mantenimiento</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido principal -->
  <main class="flex-grow container mx-auto px-4 py-10">
    <div class="bg-white p-8 rounded-xl shadow-lg">
      <h1 class="text-3xl font-bold mb-4 text-center text-green-700">📋 Lista de Mantenimientos 📋</h1>
      <p class="text-gray-600 mb-8 text-center">A continuación se muestran los registros de intervenciones realizadas.
      </p>

      <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow-sm">
          <thead class="bg-green-100 text-gray-700 font-semibold">
            <tr>
              <th class="py-3 px-4 text-left">📅 Fecha</th>
              <th class="py-3 px-4 text-left">🔧 Tipo</th>
              <th class="py-3 px-4 text-left">📝 Descripción</th>
              <th class="py-3 px-4 text-left">👤 Responsable</th>
              <th class="py-3 px-4 text-left">💬 Observaciones</th>
            </tr>
          </thead>
          <tbody>
            <% mantenimientos.forEach((m, i)=> { %>
              <tr class="border-t border-gray-200 hover:bg-green-50 cursor-pointer" onclick="mostrarModal(<%= i %>)">
                <td class="py-3 px-4">
                  <%= m.fecha.toISOString().split('T')[0] %>
                </td>
                <td class="py-3 px-4 capitalize">
                  <%= m.tipo_intervencion %>
                </td>
                <td class="py-3 px-4">
                  <%= m.descripcion %>
                </td>
                <td class="py-3 px-4">
                  <%= m.responsable %>
                </td>
                <td class="py-3 px-4">
                  <%= m.observaciones || '' %>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Modal -->
  <div id="modal" class="fixed inset-0 bg-black bg-opacity-50 hidden justify-center items-center z-50">
    <div class="bg-white w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 rounded-xl shadow-lg relative">
      <button onclick="cerrarModal()" class="absolute top-3 right-4 text-gray-600 hover:text-red-600 text-2xl">&times;</button>
      <h2 class="text-2xl font-bold text-green-700 mb-4 text-center">Detalles del Mantenimiento</h2>
      <div id="modal-content" class="space-y-4 text-gray-700">
        <!-- Aquí se insertan dinámicamente los detalles -->
      </div>
    </div>
  </div>

  <!-- Pie de página -->
  <footer class="bg-white shadow-inner py-4 mt-8">
    <div class="container mx-auto px-4 text-center">
      <p class="text-gray-700">Consulta el historial completo en el sistema o descarga los datos para análisis
        posterior.</p>
    </div>
  </footer>

  <div id="mantenimientos-data" data-json="<%= encodeURIComponent(JSON.stringify(mantenimientos)) %>" hidden></div>


  <script>
    const rawData = document.getElementById('mantenimientos-data').dataset.json;
    const mantenimientos = JSON.parse(decodeURIComponent(rawData));

    function mostrarModal(index) {
      const m = mantenimientos[index];
      const modalContent = document.getElementById('modal-content');
      modalContent.innerHTML = `
      <p><strong>📅 Fecha:</strong> ${new Date(m.fecha).toLocaleDateString()}</p>
      <p><strong>🔧 Tipo de Intervención:</strong> ${m.tipo_intervencion}</p>
      <p><strong>📚 Tipo Detalle:</strong> ${m.tipo_detalle || 'N/A'}</p>
      <p><strong>📚 Causa:</strong> ${m.causa_detalle || 'N/A'}</p>
      <p><strong>📄 Descripción:</strong> ${m.descripcion}</p>
      <p><strong>👤 Responsable:</strong> ${m.responsable}</p>
      <p><strong>💬 Observaciones:</strong> ${m.observaciones || 'Ninguna'}</p>
      ${m.ubicacion_original ? `<p><strong>📍 Ubicación Original:</strong> ${m.ubicacion_original}</p>` : ''}
      ${m.nueva_ubicacion ? `<p><strong>📍 Nueva Ubicación:</strong> ${m.nueva_ubicacion}</p>` : ''}
      ${m.exito_trasplante ? `<p><strong>✅ Éxito del Trasplante:</strong> ${m.exito_trasplante}</p>` : ''}
      ${m.destino_material ? `<p><strong>♻️ Destino del Material:</strong> ${m.destino_material}</p>` : ''}
      ${m.foto_antes ? `<div><strong>📷 Foto Antes:</strong><br><img src="/uploads/${m.foto_antes}" alt="Foto Antes" class="mt-2 w-full max-w-md mx-auto rounded-md border shadow"></div>` : ''}
      ${m.foto_despues ? `<div><strong>📷 Foto Después:</strong><br><img src="/uploads/${m.foto_despues}" alt="Foto Después" class="mt-2 w-full max-w-md mx-auto rounded-md border shadow"></div>` : ''}
    `;
      document.getElementById('modal').classList.remove('hidden');
      document.getElementById('modal').classList.add('flex');
    }

    function cerrarModal() {
      document.getElementById('modal').classList.remove('flex');
      document.getElementById('modal').classList.add('hidden');
    }
  </script>



</body>

</html>