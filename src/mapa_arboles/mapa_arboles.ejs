<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Mapa de Árboles</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow-x: hidden;
    }

    #video-fondo {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
    }

    #intro {
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      text-align: center;
      color: white;
      background-color: rgba(0,0,0,0.5);
      backdrop-filter: blur(4px);
      z-index: 10;
    }

    #mapa {
      height: 100vh;
    }

    #modal-arbol {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
      padding: 1rem;
    }

    .modal-contenido {
      background: white;
      border-radius: 0.5rem;
      max-width: 600px;
      width: 100%;
      padding: 1.5rem;
      position: relative;
    }

    .cerrar-modal {
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 1.5rem;
      font-weight: bold;
      cursor: pointer;
    }

    #carrusel {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }

    .carrusel-img {
      max-height: 80vh;
      max-width: 90vw;
      border-radius: 10px;
    }

    .carrusel-controles {
      margin-top: 1rem;
      display: flex;
      gap: 1rem;
    }

    .btn-carrusel {
      padding: 0.5rem 1rem;
      background: white;
      border-radius: 0.375rem;
      cursor: pointer;
      font-weight: bold;
    }

    @media (max-width: 640px) {
      .modal-contenido {
        padding: 1rem;
        font-size: 0.9rem;
      }
      .btn-carrusel {
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>

  <video id="video-fondo" autoplay muted loop playsinline>
    <source src="/assets/fondo.mp4" type="video/mp4">
    Tu navegador no soporta video HTML5.
  </video>

  <div id="intro">
    <h1 class="text-5xl font-bold drop-shadow-lg">Bienvenido al Mapa de Árboles</h1>
    <p class="text-xl mt-4">Desplázate hacia abajo para explorar el mapa</p>
  </div>

  <div id="mapa">
    <div id="map" style="width: 100%; height: 100%;"></div>
  </div>

  <div id="modal-arbol" class="flex">
    <div class="modal-contenido">
      <button class="cerrar-modal" onclick="cerrarModal()">×</button>
      <h2 id="modal-titulo" class="text-xl font-bold text-center mb-3"></h2>
      <img id="modal-imagen" class="w-full h-64 object-cover rounded cursor-pointer transition hover:scale-105" src="" alt="Foto del árbol" onclick="abrirCarrusel()">
      <div class="mt-4 space-y-1 text-sm text-gray-700">
        <p><strong>Altura:</strong> <span id="modal-altura"></span> m</p>
        <p><strong>Grosor copa:</strong> <span id="modal-copa"></span> m</p>
        <p><strong>Grosor tronco:</strong> <span id="modal-tronco"></span> m</p>
        <p><strong>Última inspección:</strong> <span id="modal-inspeccion"></span></p>
        <p><strong>Observaciones:</strong> <span id="modal-observaciones"></span></p>
      </div>
    </div>
  </div>

  <div id="carrusel" class="hidden flex">
    <img id="img-carrusel" class="carrusel-img" src="" alt="Imagen del árbol">
    <div class="carrusel-controles">
      <button class="btn-carrusel" onclick="anteriorImagen()">‹</button>
      <button class="btn-carrusel" onclick="cerrarCarrusel()">Cerrar</button>
      <button class="btn-carrusel" onclick="siguienteImagen()">›</button>
    </div>
  </div>

  <script>
    const arboles = <%- JSON.stringify(arboles || []) %>;
    let imagenesActuales = [];
    let indiceActual = 0;

    const map = L.map('map').setView([23.6345, -102.5528], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    arboles.forEach(arbol => {
      const color = especieColor(arbol.id_especie, arbol.id_subespecie);
      const circle = L.circle([arbol.latitud, arbol.longitud], {
        radius: arbol.grosor_copa,
        color,
        fillColor: color,
        fillOpacity: 0.5
      }).addTo(map);

      circle.on('click', () => {
        document.getElementById('modal-titulo').innerText = `${arbol.especie} ${arbol.subespecie || ''}`;
        document.getElementById('modal-imagen').src = arbol.fotos?.[0]
          ? `data:image/jpeg;base64,${arbol.fotos[0]}`
          : '/assets/default.jpg';

        document.getElementById('modal-altura').innerText = arbol.altura || 'N/A';
        document.getElementById('modal-copa').innerText = arbol.grosor_copa || 'N/A';
        document.getElementById('modal-tronco').innerText = arbol.grosor_tronco || 'N/A';
        document.getElementById('modal-inspeccion').innerText = arbol.ultima_inspeccion || 'N/A';
        document.getElementById('modal-observaciones').innerText = arbol.observaciones || 'Sin observaciones';

        imagenesActuales = arbol.fotos || [];
        indiceActual = 0;
        document.getElementById('modal-arbol').style.display = 'flex';
      });
    });

    function cerrarModal() {
      document.getElementById('modal-arbol').style.display = 'none';
    }

    function abrirCarrusel() {
      if (imagenesActuales.length === 0) return;
      document.getElementById('img-carrusel').src = `data:image/jpeg;base64,${imagenesActuales[indiceActual]}`;
      document.getElementById('carrusel').classList.remove('hidden');
      document.getElementById('carrusel').classList.add('flex');
    }

    function cerrarCarrusel() {
      document.getElementById('carrusel').classList.remove('flex');
      document.getElementById('carrusel').classList.add('hidden');
    }

    function siguienteImagen() {
      if (imagenesActuales.length === 0) return;
      indiceActual = (indiceActual + 1) % imagenesActuales.length;
      document.getElementById('img-carrusel').src = `data:image/jpeg;base64,${imagenesActuales[indiceActual]}`;
    }

    function anteriorImagen() {
      if (imagenesActuales.length === 0) return;
      indiceActual = (indiceActual - 1 + imagenesActuales.length) % imagenesActuales.length;
      document.getElementById('img-carrusel').src = `data:image/jpeg;base64,${imagenesActuales[indiceActual]}`;
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === "Escape") {
        cerrarModal();
        cerrarCarrusel();
      }
    });

    function especieColor(idEspecie, idSub) {
      const base = ["#28a745", "#007bff", "#ffc107", "#dc3545"];
      const color = base[idEspecie % base.length];
      if (!idSub) return color;
      return lightenColor(color, (idSub % 4) * 10);
    }

    function lightenColor(hex, percent) {
      let r = parseInt(hex.slice(1, 3), 16),
          g = parseInt(hex.slice(3, 5), 16),
          b = parseInt(hex.slice(5, 7), 16);
      r = Math.min(255, r + (255 - r) * percent / 100);
      g = Math.min(255, g + (255 - g) * percent / 100);
      b = Math.min(255, b + (255 - b) * percent / 100);
      return `rgb(${r},${g},${b})`;
    }
  </script>
</body>
</html>
