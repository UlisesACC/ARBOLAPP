<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
    <!--Mapa de streetmap-->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <title>Formulario de Árboles</title>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

    <!-- Barra de navegación -->
    <nav class="bg-white shadow-md">
        <div class="container mx-auto px-4 py-4 flex items-center justify-between">
            <div class="text-2xl font-bold text-green-700" id="logo">🎄 Arbol App 🎄</div>
            <ul class="flex space-x-6 text-gray-600 font-medium">
                <li><a href="/" class="hover:text-green-600">Inicio</a></li>
                <li><a href="/especies/nueva_especie" class="hover:text-green-600">Agregar Arbol</a></li>
                <li><a href="/arboles/lista_arboles" class="hover:text-green-600">Lista de Árboles</a></li>
                <li><a href="/plagas/formulario_plagas" class="hover:text-green-600">Formulario Plagas</a></li>
                <li><a href="/mantenimiento/formulario" class="hover:text-green-600">Formulario Mantenimiento</a></li>
                <li><a href="/mantenimiento/lista" class="hover:text-green-600">Lista Mantenimiento</a></li>
            </ul>
        </div>
    </nav>

    <!-- Contenedor del formulario -->
    <main class="flex-grow container mx-auto px-4 py-10">
        <div class="bg-white p-8 rounded-xl shadow-lg">
            <h1 id="titulo" class="text-3xl font-bold mb-4 text-center text-green-700">🎄 Formulario de Árboles 🎄</h1>
            <p id="subtitulo" class="text-gray-600 mb-8 text-center">Aquí podrás registrar un nuevo árbol.</p>

            <fieldset id="fieldset" class="border-2 border-green-300 rounded-lg p-6">
                <legend class="px-2 font-semibold text-green-700 text-lg">🌱 Agregando un árbol 🌱</legend>

                <form method="POST" action="/arboles/registrar_arbol" enctype="multipart/form-data"
                    class="space-y-6 mt-6">

                    <!-- Identificador del árbol -->
                    <div>
                        <label class="block text-gray-700 mb-2">Proporciona el número del árbol:</label>
                        <input type="number" name="numero_arbol" required
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
                    </div>

                    <!-- Selección de especie -->
                    <div>
                        <label class="block text-gray-700 mb-2">Selecciona la especie:</label>
                        <select id="especie" name="especie" onchange="cargarSubespecies()" required
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
                            <option value="">-- Selecciona una especie --</option>
                            <% especies.forEach(especie=> { %>
                                <option value="<%= especie.id_especie %>">
                                    <%= especie.nombre %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <!-- Selección de subespecie -->
                    <div>
                        <label class="block text-gray-700 mb-2">Selecciona la subespecie:</label>
                        <select id="subespecie" name="subespecie" required
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
                            <option value="">-- Selecciona una subespecie --</option>
                        </select>
                    </div>

                    <!-- Ubicación del árbol -->
                    <!-- Latitud -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Latitud:</label>
                        <input type="number" step="any" id="latitud" name="latitud"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Longitud -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Longitud:</label>
                        <input type="number" step="any" id="longitud" name="longitud"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Alcaldía -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Alcaldía:</label>
                        <input type="text" id="alcaldia" name="alcaldia"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Colonia -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Colonia:</label>
                        <input type="text" id="colonia" name="colonia"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Calle -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Calle:</label>
                        <input type="text" id="calle" name="calle"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Número -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Número:</label>
                        <input type="text" id="numero" name="numero"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Código Postal -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Código Postal:</label>
                        <input type="number" id="codigo_postal" name="codigo_postal"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>
                    <!-- Mapa de ubicación -->
                    <div class="mb-6">
                        <label class="block text-gray-700 mb-2">Ubicación en el mapa:</label>
                        <div id="map" class="w-full h-80 rounded-lg border border-green-300"></div>
                    </div>


                    <!-- Botón para obtener ubicación -->
                    <div class="text-center mt-6">
                        <button type="button" id="btn-ubicacion" onclick="obtenerUbicacion()"
                            class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-full transition duration-300 ease-in-out transform hover:scale-105">
                            📍 Obtener ubicación automática
                        </button>
                    </div>

                    <!-- Grosor del tronco (cm) -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Grosor del tronco (cm):</label>
                        <input type="number" step="0.01" name="grosor_tronco"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Altura del árbol (m) -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Altura del árbol (m):</label>
                        <input type="number" step="0.01" name="altura"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Grosor de la copa (m) -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Grosor de la copa (m):</label>
                        <input type="number" step="0.01" name="grosor_copa"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" />
                    </div>

                    <!-- Observaciones -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Observaciones:</label>
                        <textarea name="observaciones" rows="3"
                            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"></textarea>
                    </div>

                    <!-- Fotografía -->
                    <!-- Fotografías múltiples con vista previa -->
                    <div class="mb-4">
                        <label class="block text-gray-700 mb-2">Fotografías del árbol:</label>
                        <input type="file" id="fotosInput" name="fotografias" multiple accept="image/*"
                            class="w-full border-2 border-dashed border-green-400 bg-green-50 p-4 rounded-lg shadow-inner transition hover:border-green-600 hover:bg-green-100" />
                        <div id="previewContainer" class="mt-4 flex flex-wrap gap-4"></div>
                    </div>

                    <!-- Botón enviar -->
                    <div class="text-center">
                        <button type="submit"
                            class="bg-green-500 text-white font-semibold px-6 py-2 rounded-full hover:bg-green-600 transition">
                            Registrar Árbol
                        </button>
                    </div>

                </form>
            </fieldset>
        </div>
    </main>

    <!-- Pie de página -->
    <footer class="bg-white shadow-inner py-4 mt-8">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-700 mb-2">Consulta el siguiente PDF:</p>
            <a href="https://bioteca.biodiversidad.gob.mx/janium/Documentos/1480.pdf" target="_blank"
                class="text-green-600 hover:underline font-semibold">
                Flora del Valle de México
            </a>
        </div>
    </footer>

    <!-- Scripts de animación -->
    <script>
        // Animaciones iniciales
        anime({
            targets: "#logo",
            translateY: [-50, 0],
            opacity: [0, 1],
            duration: 1200,
            easing: "easeOutElastic(1, .8)"
        });

        anime({
            targets: "#titulo",
            scale: [0.7, 1],
            opacity: [0, 1],
            delay: 300,
            duration: 1000,
            easing: "easeOutExpo"
        });

        anime({
            targets: "#subtitulo",
            translateX: [-30, 0],
            opacity: [0, 1],
            delay: 600,
            duration: 800,
            easing: "easeOutQuad"
        });

        anime({
            targets: "#fieldset",
            opacity: [0, 1],
            translateY: [50, 0],
            delay: 900,
            duration: 900,
            easing: "easeOutCubic"
        });

        // Previsualización de fotos con opción de eliminar
        const fotosInput = document.getElementById('fotosInput');
        const previewContainer = document.getElementById('previewContainer');
        let archivosSeleccionados = [];

        fotosInput.addEventListener('change', () => {
            const nuevosArchivos = Array.from(fotosInput.files);

            nuevosArchivos.forEach((file) => {
                archivosSeleccionados.push(file);

                const reader = new FileReader();
                reader.onload = function (e) {
                    const div = document.createElement('div');
                    div.className = 'relative w-32 h-32';

                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'w-full h-full object-cover rounded shadow';

                    const botonEliminar = document.createElement('button');
                    botonEliminar.textContent = '✖';
                    botonEliminar.className = 'absolute -top-2 -right-2 bg-red-600 text-white rounded-full w-6 h-6 text-xs flex items-center justify-center';
                    botonEliminar.onclick = () => {
                        const index = archivosSeleccionados.indexOf(file);
                        if (index > -1) {
                            archivosSeleccionados.splice(index, 1);
                            actualizarInputArchivos();
                            previewContainer.removeChild(div);
                        }
                    };

                    div.appendChild(img);
                    div.appendChild(botonEliminar);
                    previewContainer.appendChild(div);
                };

                reader.readAsDataURL(file);
            });

            actualizarInputArchivos();
        });


        function actualizarInputArchivos() {
            const dataTransfer = new DataTransfer();
            archivosSeleccionados.forEach(file => dataTransfer.items.add(file));
            fotosInput.files = dataTransfer.files;
        }


        async function cargarSubespecies() {
            const especie_id = document.getElementById("especie").value;
            if (!especie_id) return;

            const respuesta = await fetch(`/subespecies/subespecies/${especie_id}`);
            const subespecies = await respuesta.json();

            const subespecieSelect = document.getElementById("subespecie");
            subespecieSelect.innerHTML = '<option value="">-- Selecciona una subespecie --</option>';

            subespecies.forEach(sub => {
                const option = document.createElement("option");
                option.value = sub.id_subespecie;
                option.textContent = sub.nombre;
                subespecieSelect.appendChild(option);
            });

            anime({
                targets: "#subespecie",
                scale: [0.9, 1],
                duration: 800,
                easing: "easeOutElastic(1, .6)"
            });
        }

        async function filtrarColonias() {
            const alcaldiaSeleccionada = document.getElementById("alcaldia").value;
            const coloniaSelect = document.getElementById("colonia");
            coloniaSelect.innerHTML = '<option value="">-- Selecciona una colonia --</option>';
            const zonas = <%- JSON.stringify(zonas) %>;
            zonas.filter(z => z.alcaldia === alcaldiaSeleccionada)
                .forEach(z => {
                    const option = document.createElement("option");
                    option.value = z.colonia;
                    option.textContent = z.colonia;
                    coloniaSelect.appendChild(option);
                });

            anime({
                targets: "#colonia",
                scale: [0.8, 1],
                duration: 700,
                easing: "easeOutElastic(1, .6)"
            });
        }

        anime({
            targets: "#btn-ubicacion",
            translateY: [50, 0],
            opacity: [0, 1],
            delay: 1300,
            duration: 1000,
            easing: "easeOutExpo"
        });

        // Función única para rellenar dirección
        function llenarDireccionDesdeDatos(data) {
            const addr = data.address;

            console.log("Dirección recibida:", addr); // sigue útil para depurar

            // Alcaldía (ahora sí, incluimos 'borough')
            document.getElementById('alcaldia').value =
                addr.borough ||       // ✅ este es el correcto en tu caso
                addr.city_district ||
                addr.municipality ||
                addr.state_district ||
                addr.county ||
                addr.region ||
                addr.suburb ||
                "";

            document.getElementById('colonia').value =
                addr.neighbourhood || addr.suburb || addr.quarter || "";

            document.getElementById('calle').value =
                addr.road || addr.street || "";

            document.getElementById('numero').value =
                addr.house_number || "";

            document.getElementById('codigo_postal').value =
                addr.postcode || "";
        }



        // Mapa Leaflet
        const map = L.map('map').setView([19.4326, -99.1332], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let marker;

        map.on('click', async function (e) {
            const { lat, lng } = e.latlng;

            document.getElementById('latitud').value = lat.toFixed(6);
            document.getElementById('longitud').value = lng.toFixed(6);

            //marca en circulo segun el grosor
            if (marker) map.removeLayer(marker);

            // Convertir metros a píxeles aproximados (ajustable)
            const grosor = parseFloat(document.querySelector('[name="grosor_copa"]').value) || 5;

            marker = L.circle([lat, lng], {
                radius: grosor, // radio en metros
                color: "green",
                fillColor: "#32CD32",
                fillOpacity: 0.5
            }).addTo(map);


            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`);
            const data = await response.json();
            console.log("Dirección recibida:", data.address);

            if (data.address) {
                llenarDireccionDesdeDatos(data);
            } else {
                alert('No se encontró dirección para esta ubicación.');
            }
        });

        async function obtenerUbicacion() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(async position => {
                    const lat = position.coords.latitude.toFixed(6);
                    const lon = position.coords.longitude.toFixed(6);

                    document.getElementById('latitud').value = lat;
                    document.getElementById('longitud').value = lon;

                    // Ubicacion mostrada como un circulo segun el grosor
                    if (marker) map.removeLayer(marker);

                    const grosor = parseFloat(document.querySelector('[name="grosor_copa"]').value) || 5;

                    marker = L.circle([lat, lon], {
                        radius: grosor,
                        color: "green",
                        fillColor: "#32CD32",
                        fillOpacity: 0.5
                    }).addTo(map);

                    map.setView([lat, lon], 17);


                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}`);
                    const data = await response.json();

                    if (data.address) {
                        llenarDireccionDesdeDatos(data);
                    } else {
                        alert('No se encontró dirección para esta ubicación.');
                    }
                }, error => {
                    console.error(error);
                    alert('No se pudo obtener la ubicación.');
                });
            } else {
                alert('Tu navegador no soporta geolocalización.');
            }
        }

        document.getElementById("btn-ubicacion").addEventListener("click", () => {
            anime({
                targets: "#btn-ubicacion",
                scale: [1, 1.1, 1],
                duration: 500,
                easing: "easeInOutQuad"
            });
        });

        document.querySelector('[name="grosor_copa"]').addEventListener('input', () => {
            if (marker) {
                const lat = marker.getLatLng().lat;
                const lng = marker.getLatLng().lng;
                const nuevoRadio = parseFloat(document.querySelector('[name="grosor_copa"]').value) || 5;

                marker.setRadius(nuevoRadio);
                map.setView([lat, lng]); // opcional
            }
        });

    </script>


</body>

</html>