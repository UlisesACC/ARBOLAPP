<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modificar Árbol</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

  <nav class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div id="logo" class="text-2xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600">Inicio</a></li>
        <li><a href="/arboles/formulario" class="hover:text-green-600">Registrar Árbol</a></li>
        <li><a href="/arboles/lista_arboles" class="hover:text-green-600">Lista de Árboles</a></li>
      </ul>
    </div>
  </nav>

  <main class="flex-grow container mx-auto px-4 py-10">
    <div class="bg-white p-8 rounded-xl shadow-lg">
      <h1 id="titulo" class="text-3xl font-bold mb-4 text-center text-green-700">🌳 Modificar Árbol 🌳</h1>

      <form method="POST" action="/arboles/modificar_arbol/<%= arbol.id_arbol %>" enctype="multipart/form-data"
        class="space-y-6">

        <div>
          <label class="block text-gray-700 mb-2">Especie:</label>
          <select name="id_especie" required
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
            <% especies.forEach(especie=> { %>
              <option value="<%= especie.id_especie %>" <% if (especie.id_especie===arbol.id_especie) { %> selected <% }
                  %>>
                  <%= especie.nombre %>
              </option>
              <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-gray-700 mb-2">Subespecie:</label>
          <select name="id_subespecie" required
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
            <% subespecies.forEach(sub=> { %>
              <option value="<%= sub.id_subespecie %>" <% if (sub.id_subespecie===arbol.id_subespecie) { %> selected <%
                  } %>>
                  <%= sub.nombre %>
              </option>
              <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-gray-700 mb-2">Grosor del tronco (cm):</label>
          <input type="number" step="0.01" name="grosor_tronco" value="<%= arbol.grosor_tronco %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"
            required>
        </div>

        <div>
          <label class="block text-gray-700 mb-2">Altura (m):</label>
          <input type="number" step="0.01" name="altura" value="<%= arbol.altura %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"
            required>
        </div>

        <div>
          <label class="block text-gray-700 mb-2">Grosor de la copa (m):</label>
          <input type="number" step="0.01" name="grosor_copa" value="<%= arbol.grosor_copa %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"
            required>
        </div>

        <div>
          <label class="block text-gray-700 mb-2">Observaciones:</label>
          <textarea name="observaciones" rows="3"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"><%= arbol.observaciones %></textarea>
        </div>

        <input type="file" name="fotografias" id="fotografias" multiple accept="image/*"
          class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
        <div id="preview" class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"></div>


        <% if (fotos && fotos.length> 0) { %>
          <div class="mt-4">
            <h3 class="text-gray-700 mb-2">Fotos actuales:</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              <% fotos.forEach(foto=> { %>
                <div class="relative border rounded p-1 shadow">
                  <img src="data:image/jpeg;base64,<%= foto.foto_base64 %>" class="w-full h-auto rounded" />
                  <form method="POST" action="/arboles/eliminar_foto/<%= foto.id_foto %>"
                    class="absolute top-0 right-0">
                    <button type="submit"
                      class="bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs hover:bg-red-700"
                      title="Eliminar foto">✕</button>
                  </form>
                </div>
                <% }) %>
            </div>
          </div>
          <% } %>

            <div class="text-center">
              <button type="submit"
                class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded-full transition transform hover:scale-105">
                Guardar Cambios
              </button>
            </div>

      </form>
    </div>
  </main>

  <footer class="bg-white shadow-inner py-4 mt-8">
    <div class="container mx-auto px-4 text-center text-gray-600">
      <p>Consulta también:
        <a href="https://bioteca.biodiversidad.gob.mx/janium/Documentos/1480.pdf" target="_blank"
          class="text-green-600 hover:underline font-semibold">
          Flora del Valle de México
        </a>
      </p>
    </div>
  </footer>

  <script>
    anime({
      targets: "#logo",
      translateY: [-30, 0],
      opacity: [0, 1],
      duration: 1000,
      easing: "easeOutElastic(1, .8)"
    });

    anime({
      targets: "#titulo",
      scale: [0.7, 1],
      opacity: [0, 1],
      delay: 300,
      duration: 1000,
      easing: "easeOutExpo"
    });

    anime({
      targets: "form",
      opacity: [0, 1],
      translateY: [50, 0],
      delay: 600,
      duration: 1000,
      easing: "easeOutCubic"
    });  
    
    
      const inputFotos = document.getElementById('fotografias');
      const preview = document.getElementById('preview');
    
      let archivosSeleccionados = [];
    
      inputFotos.addEventListener('change', (e) => {
        archivosSeleccionados = Array.from(e.target.files);
        actualizarPrevisualizacion();
      });
    
      function eliminarFoto(index) {
        archivosSeleccionados.splice(index, 1);
        actualizarPrevisualizacion();
    
        const dataTransfer = new DataTransfer();
        archivosSeleccionados.forEach(file => dataTransfer.items.add(file));
        inputFotos.files = dataTransfer.files;
      }
    
      function actualizarPrevisualizacion() {
        preview.innerHTML = '';
        archivosSeleccionados.forEach((archivo, index) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const div = document.createElement('div');
            div.className = 'relative';
    
            const img = document.createElement('img');
            img.src = e.target.result;
            img.alt = 'preview';
            img.className = 'w-full h-32 object-cover rounded shadow';
    
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.innerText = '❌';
            btn.className = 'absolute top-1 right-1 bg-red-500 text-white text-sm px-2 py-1 rounded';
            btn.onclick = () => eliminarFoto(index);
    
            div.appendChild(img);
            div.appendChild(btn);
            preview.appendChild(div);
          };
          reader.readAsDataURL(archivo);
        });
      }

  </script>    


</body>

</html>
