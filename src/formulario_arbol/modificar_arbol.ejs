<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Modificar Árbol</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Barra de navegación -->
  <nav class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div id="logo" class="text-2xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600">Inicio</a></li>
        <li><a href="/formulario" class="hover:text-green-600">Registrar Árbol</a></li>
        <li><a href="/lista_arboles" class="hover:text-green-600">Lista de Árboles</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido principal -->
  <main class="flex-grow container mx-auto px-4 py-10">
    <div class="bg-white p-8 rounded-xl shadow-lg">
      <h1 id="titulo" class="text-3xl font-bold mb-4 text-center text-green-700">🌳 Modificar Árbol 🌳</h1>

      <form method="POST" action="/modificar_arbol/<%= arbol.id_arbol %>" enctype="multipart/form-data" class="space-y-6">

        <!-- Especie -->
        <div>
          <label class="block text-gray-700 mb-2">Especie:</label>
          <select name="id_especie" required
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
            <% especies.forEach(especie => { %>
              <option value="<%= especie.id_especie %>" 
                <% if (especie.id_especie === arbol.id_especie) { %> selected <% } %>>
                <%= especie.nombre %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Subespecie -->
        <div>
          <label class="block text-gray-700 mb-2">Subespecie:</label>
          <select name="id_subespecie" required
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
            <% subespecies.forEach(sub => { %>
              <option value="<%= sub.id_subespecie %>" 
                <% if (sub.id_subespecie === arbol.id_subespecie) { %> selected <% } %>>
                <%= sub.nombre %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Grosor del tronco -->
        <div>
          <label class="block text-gray-700 mb-2">Grosor del tronco (cm):</label>
          <input type="number" step="0.01" name="grosor_tronco" value="<%= arbol.grosor_tronco %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" required>
        </div>

        <!-- Altura -->
        <div>
          <label class="block text-gray-700 mb-2">Altura (m):</label>
          <input type="number" step="0.01" name="altura" value="<%= arbol.altura %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" required>
        </div>

        <!-- Grosor de copa -->
        <div>
          <label class="block text-gray-700 mb-2">Grosor de la copa (m):</label>
          <input type="number" step="0.01" name="grosor_copa" value="<%= arbol.grosor_copa %>"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400" required>
        </div>

        <!-- Observaciones -->
        <div>
          <label class="block text-gray-700 mb-2">Observaciones:</label>
          <textarea name="observaciones" rows="3"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400"><%= arbol.observaciones %></textarea>
        </div>

        <!-- Fotografía -->
        <div>
          <label class="block text-gray-700 mb-2">Fotografía nueva (opcional):</label>
          <input type="file" name="fotografia"
            class="w-full border border-gray-300 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-green-400">
        </div>

        <!-- Botón -->
        <div class="text-center">
          <button type="submit"
            class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded-full transition transform hover:scale-105">
            Guardar Cambios
          </button>
        </div>

      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-white shadow-inner py-4 mt-8">
    <div class="container mx-auto px-4 text-center text-gray-600">
      <p>Consulta también: 
        <a href="https://bioteca.biodiversidad.gob.mx/janium/Documentos/1480.pdf" target="_blank" class="text-green-600 hover:underline font-semibold">
          Flora del Valle de México
        </a>
      </p>
    </div>
  </footer>

  <!-- Animaciones Anime.js -->
  <script>
    // Animación para el logo
    anime({
      targets: "#logo",
      translateY: [-30, 0],
      opacity: [0, 1],
      duration: 1000,
      easing: "easeOutElastic(1, .8)"
    });

    // Animación para el título
    anime({
      targets: "#titulo",
      scale: [0.7, 1],
      opacity: [0, 1],
      delay: 300,
      duration: 1000,
      easing: "easeOutExpo"
    });

    // Animación del formulario
    anime({
      targets: "form",
      opacity: [0, 1],
      translateY: [50, 0],
      delay: 600,
      duration: 1000,
      easing: "easeOutCubic"
    });
  </script>

</body>
</html>
