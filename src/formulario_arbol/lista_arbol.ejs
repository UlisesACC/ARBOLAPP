<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Árboles</title>
  <link href="/src/formulario_arbol/output.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>

  <style>
    .carrusel-imagen {
      position: absolute;
      transition: transform 0.6s ease, opacity 0.6s ease;
      border-radius: 0.5rem;
      cursor: pointer;
      max-height: 60vh;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .perspective-3d {
      perspective: 1000px;
    }
  </style>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Barra de navegación -->
  <nav class="bg-white shadow-md">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div id="logo" class="text-2xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600">Inicio</a></li>
        <li><a href="/arboles/formulario" class="hover:text-green-600">Registrar Árbol</a></li>
      </ul>
    </div>
  </nav>

  <!-- Contenido principal -->
  <main class="flex-grow container mx-auto px-4 py-10">
    <h1 id="titulo" class="text-3xl font-bold mb-8 text-center text-green-700">🌳 Lista de Árboles 🌳</h1>

    <div class="overflow-x-auto">
      <table id="tabla-arboles" class="min-w-full bg-white rounded-xl shadow-lg">
        <thead class="bg-green-500 text-white">
          <tr>
            <th class="py-3 px-6 text-left">ID Árbol</th>
            <th class="py-3 px-6 text-left">Especie</th>
            <th class="py-3 px-6 text-left">Subespecie</th>
            <th class="py-3 px-6 text-left">Alcaldía</th>
            <th class="py-3 px-6 text-left">Colonia</th>
            <th class="py-3 px-6 text-left">Altura (m)</th>
            <th class="py-3 px-6 text-left">Observaciones</th>
            <th class="py-3 px-6 text-left">Fotos</th>
            <th class="py-3 px-6 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="text-gray-700">
          <% arboles.forEach((arbol)=> { %>
            <tr class="border-b fila-arbol" style="opacity:0;">
              <td class="py-4 px-6">
                <%= arbol.id_arbol %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.nombre_especie || '-' %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.nombre_subespecie || '-' %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.alcaldia || '-' %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.colonia || '-' %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.altura || '-' %>
              </td>
              <td class="py-4 px-6">
                <%= arbol.observaciones || '-' %>
              </td>
              <td class="py-4 px-6">
                <% if (arbol.fotos_base64 && arbol.fotos_base64.length> 0) { %>
                  <img src="data:image/jpeg;base64,<%= arbol.fotos_base64[0] %>"
                    class="w-20 h-20 object-cover rounded cursor-pointer hover:scale-105 transition" alt="foto"
                    onclick='abrirCarrusel(<%- JSON.stringify(arbol.fotos_base64) %>)'>
                  <% } else { %>
                    <span class="text-gray-400 italic">Sin fotos</span>
                    <% } %>
              </td>
              <td class="py-4 px-6 text-center flex gap-2 justify-center">
                <form method="POST" action="/arboles/eliminar_arbol/<%= arbol.id_arbol %>">
                  <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-full">
                    Eliminar
                  </button>
                </form>
                <a href="/arboles/modificar_arbol/<%= arbol.id_arbol %>"
                  class="bg-yellow-400 hover:bg-yellow-500 text-white font-bold py-2 px-4 rounded-full">
                  Editar
                </a>
              </td>
            </tr>
            <% }); %>
        </tbody>
      </table>
    </div>
  </main>

  <!-- Modal de carrusel -->
  <!-- Modal de carrusel -->
  <div id="modalImagen" class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center hidden z-50">
    <div id="contenedorModal" class="relative max-w-3xl w-full px-4 perspective-3d bg-transparent">
      <button onclick="cerrarModal()"
        class="absolute top-2 right-2 bg-red-500 text-white rounded-full px-3 py-1 text-xl font-bold hover:bg-red-600">✕</button>
      <div id="carrusel3D" class="relative flex items-center justify-center h-[60vh] overflow-hidden">
        <!-- Las imágenes se insertarán dinámicamente -->
      </div>
    </div>
  </div>


  <!-- Footer -->
  <footer class="bg-white shadow-inner py-4 mt-8">
    <div class="container mx-auto px-4 text-center text-gray-600">
      <p>Consulta también:
        <a href="https://bioteca.biodiversidad.gob.mx/janium/Documentos/1480.pdf" target="_blank"
          class="text-green-600 hover:underline font-semibold">Flora del Valle de México</a>
      </p>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    anime({
      targets: "#logo",
      translateY: [-30, 0],
      opacity: [0, 1],
      duration: 1000,
      easing: "easeOutElastic(1, .8)"
    });

    anime({
      targets: "#titulo",
      scale: [0.7, 1],
      opacity: [0, 1],
      delay: 400,
      duration: 1000,
      easing: "easeOutExpo"
    });

    anime({
      targets: ".fila-arbol",
      opacity: [0, 1],
      translateY: [30, 0],
      delay: anime.stagger(100, { start: 800 }),
      duration: 800,
      easing: "easeOutCubic"
    });

    let fotos = [];
    let indice = 0;
    let intervalo = null;

    function abrirCarrusel(listaBase64) {
      fotos = listaBase64;
      indice = 0;

      const modal = document.getElementById("modalImagen");
      const carrusel = document.getElementById("contenedorModal");
      carrusel.innerHTML = `
    <button onclick="cerrarModal()"
      class="absolute top-2 right-2 bg-red-500 text-white rounded-full px-3 py-1 text-xl font-bold hover:bg-red-600">✕</button>
  `;

      // Agregar imágenes al carrusel
      fotos.forEach((foto, i) => {
        const img = document.createElement("img");
        img.src = `data:image/jpeg;base64,${foto}`;
        img.className = "carrusel-imagen absolute top-1/2 left-1/2 max-h-[80vh] rounded-lg shadow-lg border-4 border-white transform transition-transform duration-500";
        img.dataset.index = i;
        img.style.zIndex = fotos.length - i;
        img.addEventListener("click", () => mostrarImagen(i));
        carrusel.appendChild(img);
      });

      modal.classList.remove("hidden");
      mostrarImagen(indice);

      // Efecto 3D con movimiento del mouse
      document.querySelectorAll(".carrusel-imagen").forEach(img => {
        img.addEventListener("mousemove", (e) => {
          const { width, height, left, top } = img.getBoundingClientRect();
          const x = e.clientX - left;
          const y = e.clientY - top;
          const rotX = ((y / height) - 0.5) * 10;
          const rotY = ((x / width) - 0.5) * 10;
          img.style.transform += ` rotateX(${-rotX}deg) rotateY(${rotY}deg)`;
        });

        img.addEventListener("mouseleave", () => {
          mostrarImagen(indice); // Resetea transformaciones
        });
      });

      // Animación automática cada 5 segundos
      intervalo = setInterval(() => {
        indice = (indice + 1) % fotos.length;
        mostrarImagen(indice);
      }, 3000);
    }

    // Posiciona las imágenes en modo 3D centrando una
    function mostrarImagen(i) {
      const imagenes = document.querySelectorAll(".carrusel-imagen");
      imagenes.forEach((img, idx) => {
        const offset = idx - i;
        const scale = offset === 0 ? 1 : 0.7;
        const translateX = offset * 250;
        const rotateY = offset * -45;

        img.style.zIndex = imagenes.length - Math.abs(offset);
        img.style.transform = `translateX(${translateX}px) translateY(-50%) scale(${scale}) rotateY(${rotateY}deg)`;
        img.style.opacity = offset < -2 || offset > 2 ? "0" : "1"; // Esconde si está lejos
      });
    }

    function cerrarModal() {
      clearInterval(intervalo);
      document.getElementById("modalImagen").classList.add("hidden");
      document.getElementById("carrusel3D").innerHTML = "";
    }

    document.getElementById("modalImagen").addEventListener("click", function (e) {
      const imagen = document.getElementById("imagenGrande");
      const botonCerrar = e.target.closest("button");

      if (!imagen.contains(e.target) && !botonCerrar) {
        cerrarModal();
      }
    });

    // Cerrar modal al presionar la tecla ESC
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        cerrarModal();
      }
    });

    document.getElementById("modalImagen").addEventListener("click", function (e) {
      const esImagen = e.target.classList.contains("carrusel-imagen");
      const esBoton = e.target.closest("button");

      if (!esImagen && !esBoton) {
        cerrarModal();
      }
    });

  </script>
</body>

</html>