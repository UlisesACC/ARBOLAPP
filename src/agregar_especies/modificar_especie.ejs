<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Modificar Especie</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-green-50 min-h-screen flex flex-col">

  <nav class="bg-white shadow-md sticky top-0 z-50">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <div class="text-xl font-bold text-green-700">🎄 Arbol App 🎄</div>
      <ul class="flex space-x-6 text-gray-600 font-medium">
        <li><a href="/" class="hover:text-green-600 transition">Inicio</a></li>
        <li><a href="/arboles/formulario" class="hover:text-green-600 transition">Registrar Árbol</a></li>
        <li><a href="/especies/lista_especies" class="hover:text-green-600 transition">Lista de Especies</a></li>
      </ul>
    </div>
  </nav>

  <main class="flex-1 container mx-auto px-4 pt-32 flex justify-center">
    <div class="bg-white shadow-2xl rounded-2xl p-10 w-full max-w-2xl">
      <h1 class="text-3xl font-bold text-center text-green-700 mb-6">Modificar Especie</h1>

      <form action="/especies/modificar_especie/<%= especie.id_especie %>" method="POST" enctype="multipart/form-data"
        class="space-y-6">

        <div>
          <label for="nombre" class="block text-gray-700 font-semibold mb-2">Nombre:</label>
          <input type="text" name="nombre" id="nombre" value="<%= especie.nombre %>" required
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
        </div>

        <div>
          <label for="descripcion" class="block text-gray-700 font-semibold mb-2">Descripción:</label>
          <textarea name="descripcion" id="descripcion" rows="5"
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"><%= especie.descripcion %></textarea>
        </div>

        <div>
          <label class="block text-gray-700 font-semibold mb-2">Fotografía Actual:</label>
          <% if (especie.fotografia) { %>
            <img src="data:image/jpeg;base64,<%= especie.fotografia.toString('base64') %>" alt="Foto actual"
              class="h-24 mb-4 rounded-lg mx-auto">
            <% } else { %>
              <p class="text-center text-gray-400">Sin fotografía</p>
              <% } %>

        </div>

        <div>
          <label for="fotografia" class="block text-gray-700 font-semibold mb-2">Cambiar Fotografía (opcional):</label>
          <input type="file" name="fotografia" id="fotografia" class="w-full p-3 border border-gray-300 rounded-lg">
        </div>

        <button type="submit"
          class="w-full bg-green-700 hover:bg-green-800 text-white font-bold py-3 rounded-xl transition">
          Guardar Cambios
        </button>
      </form>
    </div>
  </main>

</body>

</html>
